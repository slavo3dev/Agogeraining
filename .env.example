# Copy to .env (never commit real values). Placeholders only.

# --- Mobile (public, safe to embed; protected by RLS) ---
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key printed by `supabase start`>
# Only set to "true" in dev builds. Production builds ignore it.
EXPO_PUBLIC_ENABLE_DEMO_MODE=false

# --- Server-side only (Edge Functions / admin). NEVER ship to a device. ---
SUPABASE_SERVICE_ROLE_KEY=<server-only>

# --- Optional auth providers (only enable the ones you configure in Supabase) ---
# SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
