# Each app has its own example with the public (anon) values it reads:
#   apps/mobile/.env.example  → copy to apps/mobile/.env.local  (EXPO_PUBLIC_*)
#   apps/web/.env.example     → copy to apps/web/.env.local     (NEXT_PUBLIC_*)
# Never commit real values.

# --- Server-side only (Edge Functions / admin). NEVER ship to a device or browser. ---
SUPABASE_SERVICE_ROLE_KEY=<server-only>

# --- Optional auth providers (only enable the ones you configure in Supabase) ---
# SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
