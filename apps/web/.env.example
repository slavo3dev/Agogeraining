# Copy to apps/web/.env.local. Only public (anon) values belong here — never the service-role key.
# Local Supabase: run `pnpm db:start` and paste the API URL and anon key it prints.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Local demo (simulated on this browser only). Honoured by `next dev` only, never by production builds.
NEXT_PUBLIC_ENABLE_DEMO_MODE=true
