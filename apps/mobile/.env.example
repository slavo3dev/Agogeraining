# Copy to apps/mobile/.env.local. Only public (anon) values belong here — never the service-role key.
# Local Supabase: run `pnpm db:start` and paste the API URL and anon key it prints.
# On a physical phone use your Mac's LAN IP (ipconfig getifaddr en0) instead of 127.0.0.1.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Local demo (simulated on this device only). Dev builds only.
EXPO_PUBLIC_ENABLE_DEMO_MODE=true
